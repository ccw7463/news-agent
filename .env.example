# ── Required ────────────────────────────────────────────────────────────────
# The agent's LLM, served through OpenRouter. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Any OpenRouter model that supports tool calling. The default is a preview
# model; pin a stable one here if it is withdrawn.
# OPENROUTER_MODEL=google/gemini-3-flash-preview
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_TEMPERATURE=0.2

# ── How to reach google-rss-mcp ─────────────────────────────────────────────
# Unset: start at `smithery` if SMITHERY_API_KEY is set, else `http`, then fall
# back down the chain. Set explicitly to pin one mode with no fallback.
#   smithery  published listing via the Smithery gateway (needs the key below)
#   http      origin instance, no key
#   stdio     upstream source run locally by uvx
#   local     vendored copy in src/modules/mcp_servers, no network
# MCP_MODE=smithery

# Optional. The Smithery gateway is an OAuth 2.0 protected resource: every one
# of its hostnames answers 401 to anonymous requests. That is Smithery's access
# control in front of the server, not something the server itself requires — the
# `http` mode below reaches the same server with no key at all. Only set this if
# you specifically want traffic to go through the published listing.
# Key: https://smithery.ai/account/api-keys
# SMITHERY_API_KEY=

# Override only if the published URLs move. The gateway URL is the registry's
# `deploymentUrl` verbatim — no /mcp path; /mcp on that host answers 404.
#   curl https://registry.smithery.ai/servers/@ccw7463/google-rss-mcp
# SMITHERY_URL=https://google-rss-mcp--ccw7463.run.tools
# MCP_HTTP_URL=https://google-rss-mcp-production.up.railway.app/mcp

# ── Locale ──────────────────────────────────────────────────────────────────
# Applies to the `stdio` and `local` modes, which we launch ourselves. Remote
# instances stay neutral (en/US) and take the locale per tool call instead.
# GOOGLE_RSS_LANGUAGE=ko
# GOOGLE_RSS_REGION=KR

# ── Reading budget ──────────────────────────────────────────────────────────
# Bodies dominate latency and tokens, so far fewer are read than are searched.
# MAX_READ_ARTICLES=5
# MAX_ARTICLE_LENGTH=4000

# Also passed to the stdio/local servers, which otherwise print their
# banner, request timing, and a full traceback for every 403 paywall.
# LOG_LEVEL=INFO
